{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echo.local/schemas/history-agent.v1.input.schema.json",
  "title": "Echo History Agent Input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "pack_id",
    "journey_id",
    "seed_version",
    "changed_variable",
    "changed_variable_fact_id",
    "input_facts",
    "allowed_input_fact_ids",
    "reference_facts",
    "output_language",
    "generated_at"
  ],
  "properties": {
    "schema_version": { "const": "history-agent-input.v1" },
    "request_id": { "$ref": "#/$defs/id" },
    "pack_id": { "$ref": "#/$defs/id" },
    "journey_id": { "$ref": "#/$defs/id" },
    "seed_version": { "type": "integer", "minimum": 1 },
    "changed_variable": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "changed_variable_fact_id": { "$ref": "#/$defs/id" },
    "input_facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fact_id",
          "kind",
          "value",
          "source",
          "evidence_turn_ids"
        ],
        "properties": {
          "fact_id": { "$ref": "#/$defs/id" },
          "kind": {
            "enum": [
              "changed_variable",
              "fork_moment",
              "real_path",
              "profile",
              "reality_constraint",
              "valued_continuity",
              "decision_context",
              "target_question"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "source": {
            "enum": ["user_confirmed", "seed_constraint"]
          },
          "evidence_turn_ids": {
            "type": "array",
            "maxItems": 12,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          }
        }
      }
    },
    "allowed_input_fact_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "reference_facts": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference_fact_id",
          "statement",
          "publisher",
          "source_locator",
          "retrieved_at",
          "as_of",
          "time_sensitive"
        ],
        "properties": {
          "reference_fact_id": { "$ref": "#/$defs/id" },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "publisher": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "source_locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "retrieved_at": { "type": "string", "format": "date-time" },
          "as_of": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "time_sensitive": { "type": "boolean" }
        }
      }
    },
    "output_language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40
    },
    "generated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
    }
  }
}
