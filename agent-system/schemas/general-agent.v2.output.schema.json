{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echo.local/schemas/general-agent.v2.output.schema.json",
  "title": "Echo General Agent Output v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent_proposal",
    "field_operations",
    "profile_conflict",
    "next_turn",
    "memory_candidates",
    "safety_signal"
  ],
  "properties": {
    "intent_proposal": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "evidence_level", "evidence_turn_ids"],
          "properties": {
            "type": {
              "enum": [
                "past_unchosen",
                "current_fork",
                "revisit_without_change",
                "open_exploration"
              ]
            },
            "evidence_level": { "$ref": "#/$defs/evidenceLevel" },
            "evidence_turn_ids": { "$ref": "#/$defs/turnIds" }
          }
        }
      ]
    },
    "field_operations": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "field_path",
          "value",
          "evidence_level",
          "evidence"
        ],
        "properties": {
          "operation": {
            "enum": [
              "propose",
              "replace",
              "confirm_signal",
              "reject_signal"
            ]
          },
          "field_path": {
            "enum": [
              "intent",
              "fork_moment",
              "unchosen_path",
              "real_path",
              "decision_mechanism.stated_reasons",
              "decision_mechanism.practical_constraints",
              "decision_mechanism.preferences_at_the_time",
              "decision_mechanism.fears",
              "decision_mechanism.hopes",
              "decision_mechanism.attachments",
              "decision_mechanism.unknowns",
              "invariants.reality_constraints",
              "invariants.valued_continuities",
              "target_question"
            ]
          },
          "value": {
            "oneOf": [
              { "type": "null" },
              { "$ref": "#/$defs/textValue" },
              {
                "type": "array",
                "maxItems": 8,
                "items": { "$ref": "#/$defs/textValue" }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["verbatim", "simulation_focus"],
                "properties": {
                  "verbatim": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "simulation_focus": {
                    "type": "array",
                    "maxItems": 6,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    }
                  }
                }
              }
            ]
          },
          "evidence_level": { "$ref": "#/$defs/evidenceLevel" },
          "evidence": {
            "type": "array",
            "maxItems": 8,
            "items": { "$ref": "#/$defs/evidence" }
          },
          "replaces_candidate_id": {
            "type": ["string", "null"],
            "maxLength": 100
          },
          "presented_seed_version": {
            "type": ["integer", "null"],
            "minimum": 1
          }
        }
      }
    },
    "profile_conflict": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "field",
            "profile_value",
            "new_verbatim",
            "evidence_turn_id"
          ],
          "properties": {
            "field": { "enum": ["name", "current_identity"] },
            "profile_value": {
              "type": "string",
              "maxLength": 300
            },
            "new_verbatim": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "evidence_turn_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          }
        }
      ]
    },
    "next_turn": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "goal",
            "question",
            "why_now",
            "expected_answer_shape",
            "interaction_type",
            "allow_skip",
            "suggestion_intents"
          ],
          "properties": {
            "goal": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "question": {
              "type": "string",
              "minLength": 1,
              "maxLength": 280
            },
            "why_now": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "expected_answer_shape": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "interaction_type": {
              "enum": [
                "voice_text",
                "short_text",
                "path_cards",
                "confirm_card",
                "route_notice",
                "safety_handoff"
              ]
            },
            "allow_skip": { "type": "boolean" },
            "suggestion_intents": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            }
          }
        }
      ]
    },
    "memory_candidates": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_key",
          "operation",
          "content",
          "evidence_turn_ids",
          "sensitivity"
        ],
        "properties": {
          "candidate_key": {
            "type": "string",
            "pattern": "^[a-z0-9_.-]{3,160}$"
          },
          "operation": { "enum": ["upsert", "reject"] },
          "content": { "$ref": "#/$defs/textValue" },
          "evidence_turn_ids": { "$ref": "#/$defs/turnIds" },
          "sensitivity": { "enum": ["normal", "sensitive"] }
        }
      }
    },
    "safety_signal": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["category", "evidence"],
          "properties": {
            "category": {
              "enum": [
                "possible_self_harm",
                "possible_harm_to_others",
                "acute_crisis",
                "other_sensitive"
              ]
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": { "$ref": "#/$defs/evidence" }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "evidenceLevel": {
      "enum": ["explicit", "confirmed", "ambiguous", "inferred"]
    },
    "turnIds": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "textValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verbatim", "normalized"],
      "properties": {
        "verbatim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "normalized": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turn_id", "quote"],
      "properties": {
        "turn_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    }
  }
}
