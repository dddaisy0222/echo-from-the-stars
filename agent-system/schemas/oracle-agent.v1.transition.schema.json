{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echo.local/schemas/oracle-agent.v1.transition.schema.json",
  "title": "Echo Oracle Transition Proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "transition_id",
    "world_id",
    "journey_id",
    "seed_version",
    "pack_id",
    "based_on_state_version",
    "mode",
    "requested_node_id",
    "node",
    "operations",
    "causal_edges",
    "instantiated_uncertain_event_ids",
    "generated_at"
  ],
  "properties": {
    "schema_version": { "const": "oracle-transition.v1" },
    "request_id": { "$ref": "#/$defs/id" },
    "transition_id": { "$ref": "#/$defs/id" },
    "world_id": { "$ref": "#/$defs/id" },
    "journey_id": { "$ref": "#/$defs/id" },
    "seed_version": { "type": "integer", "minimum": 1 },
    "pack_id": { "$ref": "#/$defs/id" },
    "based_on_state_version": { "type": "integer", "minimum": 0 },
    "mode": { "enum": ["initialize", "advance"] },
    "requested_node_id": { "$ref": "#/$defs/id" },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "horizon",
        "title",
        "situation",
        "ordinary_details",
        "render_cues",
        "continuity_refs",
        "active_tension_ids",
        "state_change_op_ids",
        "choices",
        "uncertainties"
      ],
      "properties": {
        "node_id": { "$ref": "#/$defs/id" },
        "horizon": { "$ref": "#/$defs/horizon" },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "situation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "ordinary_details": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "render_cues": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/renderCue" }
        },
        "continuity_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "active_tension_ids": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "state_change_op_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/choice" }
        },
        "uncertainties": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/operation" }
    },
    "causal_edges": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/causalEdge" }
    },
    "instantiated_uncertain_event_ids": {
      "type": "array",
      "maxItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "generated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
    },
    "horizon": {
      "enum": [
        "week_1_2",
        "month_1",
        "month_3",
        "month_6",
        "year_1",
        "year_2_plus"
      ]
    },
    "dimension": {
      "enum": [
        "economic",
        "relational",
        "legal_visa",
        "skill",
        "time",
        "health_baseline",
        "caregiving",
        "social_environment",
        "geography",
        "institutional",
        "agency"
      ]
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "choice_id",
        "strategy",
        "label",
        "action",
        "commits_to",
        "preserves",
        "exposes_to",
        "does_not_guarantee",
        "reversibility",
        "feedback_horizon"
      ],
      "properties": {
        "choice_id": { "$ref": "#/$defs/id" },
        "strategy": {
          "enum": [
            "seek_clarity",
            "protect_boundary",
            "invest_depth",
            "experiment",
            "defer_commitment",
            "request_support",
            "reduce_scope",
            "accept_short_term_cost",
            "other"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "commits_to": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "preserves": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "exposes_to": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "does_not_guarantee": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "reversibility": { "enum": ["easy", "moderate", "hard"] },
        "feedback_horizon": { "enum": ["immediate", "next_node", "long_term"] }
      }
    },
    "renderCue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cue_id",
        "kind",
        "detail",
        "causal_refs",
        "persistence"
      ],
      "properties": {
        "cue_id": { "$ref": "#/$defs/id" },
        "kind": {
          "enum": ["object", "routine", "ambience", "spatial", "interface"]
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "causal_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "persistence": { "enum": ["node_only", "callback_candidate"] }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op_id",
        "target_type",
        "operation",
        "target_id",
        "target_label",
        "before_state",
        "after_state",
        "dimensions",
        "causal_refs"
      ],
      "properties": {
        "op_id": { "$ref": "#/$defs/id" },
        "target_type": { "enum": ["variable", "tension"] },
        "operation": { "enum": ["create", "update", "resolve", "transform"] },
        "target_id": { "$ref": "#/$defs/id" },
        "target_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "before_state": {
          "type": ["string", "null"],
          "maxLength": 700
        },
        "after_state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 700
        },
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/dimension" }
        },
        "causal_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "operation": { "const": "create" } },
            "required": ["operation"]
          },
          "then": {
            "properties": { "before_state": { "type": "null" } }
          },
          "else": {
            "properties": {
              "before_state": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "if": {
            "properties": { "operation": { "const": "transform" } },
            "required": ["operation"]
          },
          "then": {
            "properties": { "target_type": { "const": "tension" } }
          }
        }
      ]
    },
    "causalEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_id",
        "cause_refs",
        "effect_op_ids",
        "mechanism",
        "strength"
      ],
      "properties": {
        "edge_id": { "$ref": "#/$defs/id" },
        "cause_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "effect_op_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "mechanism": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "strength": { "enum": ["grounded", "plausible"] }
      }
    }
  }
}
