{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echo.local/schemas/world-state.v1.schema.json",
  "title": "Echo World State v1",
  "description": "由确定性 World Reducer 维护的模拟世界唯一状态源。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "world_id",
    "journey_id",
    "seed_version",
    "pack_id",
    "state_version",
    "simulation_label",
    "current_horizon",
    "variables",
    "tensions",
    "experienced_nodes",
    "pending_choice",
    "last_transition_id",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": "world-state.v1" },
    "world_id": { "$ref": "#/$defs/id" },
    "journey_id": { "$ref": "#/$defs/id" },
    "seed_version": { "type": "integer", "minimum": 1 },
    "pack_id": { "$ref": "#/$defs/id" },
    "state_version": { "type": "integer", "minimum": 1 },
    "simulation_label": { "const": "counterfactual_simulation" },
    "current_horizon": { "$ref": "#/$defs/horizon" },
    "variables": {
      "type": "array",
      "maxItems": 60,
      "items": { "$ref": "#/$defs/variable" }
    },
    "tensions": {
      "type": "array",
      "maxItems": 30,
      "items": { "$ref": "#/$defs/tension" }
    },
    "experienced_nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": { "$ref": "#/$defs/experiencedNode" }
    },
    "pending_choice": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["node_id", "choice_ids"],
          "properties": {
            "node_id": { "$ref": "#/$defs/id" },
            "choice_ids": {
              "type": "array",
              "minItems": 2,
              "maxItems": 3,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/id" }
            }
          }
        }
      ]
    },
    "last_transition_id": { "$ref": "#/$defs/id" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
    },
    "horizon": {
      "enum": [
        "week_1_2",
        "month_1",
        "month_3",
        "month_6",
        "year_1",
        "year_2_plus"
      ]
    },
    "dimension": {
      "enum": [
        "economic",
        "relational",
        "legal_visa",
        "skill",
        "time",
        "health_baseline",
        "caregiving",
        "social_environment",
        "geography",
        "institutional",
        "agency"
      ]
    },
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variable_id",
        "label",
        "state",
        "dimensions",
        "status",
        "provenance_refs",
        "updated_transition_id"
      ],
      "properties": {
        "variable_id": { "$ref": "#/$defs/id" },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 700
        },
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/dimension" }
        },
        "status": { "enum": ["active", "superseded"] },
        "provenance_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "updated_transition_id": { "$ref": "#/$defs/id" }
      }
    },
    "tension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tension_id",
        "label",
        "state",
        "dimensions",
        "status",
        "provenance_refs",
        "updated_transition_id"
      ],
      "properties": {
        "tension_id": { "$ref": "#/$defs/id" },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 700
        },
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/dimension" }
        },
        "status": { "enum": ["active", "resolved", "transformed"] },
        "provenance_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "updated_transition_id": { "$ref": "#/$defs/id" }
      }
    },
    "experiencedNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "transition_id",
        "horizon",
        "summary",
        "committed_choice_event_id"
      ],
      "properties": {
        "node_id": { "$ref": "#/$defs/id" },
        "transition_id": { "$ref": "#/$defs/id" },
        "horizon": { "$ref": "#/$defs/horizon" },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "committed_choice_event_id": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
        }
      }
    }
  }
}
