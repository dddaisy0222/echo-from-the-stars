{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echo.local/schemas/oracle-agent.v1.calibration-output.schema.json",
  "title": "Echo Oracle World Calibration Output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "world_id",
    "journey_id",
    "seed_version",
    "pack_id",
    "mode",
    "items",
    "next_turn",
    "deferred_unknowns",
    "generated_at"
  ],
  "properties": {
    "schema_version": { "const": "oracle-calibration-output.v1" },
    "request_id": { "$ref": "#/$defs/id" },
    "world_id": { "$ref": "#/$defs/id" },
    "journey_id": { "$ref": "#/$defs/id" },
    "seed_version": { "type": "integer", "minimum": 1 },
    "pack_id": { "$ref": "#/$defs/id" },
    "mode": { "const": "calibrate" },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "calibration_id",
          "topic",
          "impact",
          "premise_type",
          "why_it_matters",
          "candidates"
        ],
        "properties": {
          "calibration_id": { "$ref": "#/$defs/id" },
          "topic": { "$ref": "#/$defs/topic" },
          "impact": {
            "enum": ["world_shaping", "daily_structure", "texture"]
          },
          "premise_type": {
            "enum": [
              "real_world_fact",
              "counterfactual_premise",
              "texture_preference"
            ]
          },
          "why_it_matters": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "candidates": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "candidate_id",
                "label",
                "premise",
                "source",
                "evidence_refs",
                "affects"
              ],
              "properties": {
                "candidate_id": { "$ref": "#/$defs/id" },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "premise": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "source": {
                  "enum": [
                    "user_evidence",
                    "verified_reference",
                    "model_hypothesis"
                  ]
                },
                "evidence_refs": {
                  "type": "array",
                  "maxItems": 12,
                  "uniqueItems": true,
                  "items": { "$ref": "#/$defs/id" }
                },
                "affects": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "$ref": "#/$defs/dimension" }
                }
              }
            }
          }
        }
      }
    },
    "next_turn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calibration_id",
        "question",
        "why_now",
        "interaction_type",
        "candidate_ids",
        "allow_unknown",
        "allow_free_text"
      ],
      "properties": {
        "calibration_id": { "$ref": "#/$defs/id" },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "why_now": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "interaction_type": {
          "enum": ["choice_with_other", "short_text"]
        },
        "candidate_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "allow_unknown": { "const": true },
        "allow_free_text": { "type": "boolean" }
      }
    },
    "deferred_unknowns": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topic", "handling"],
        "properties": {
          "topic": { "$ref": "#/$defs/topic" },
          "handling": {
            "enum": [
              "keep_unknown",
              "use_neutral_language",
              "research_before_use",
              "ask_later_if_causally_relevant"
            ]
          }
        }
      }
    },
    "generated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
    },
    "topic": {
      "enum": [
        "role_track",
        "housing",
        "commute_mode",
        "commute_duration",
        "work_schedule",
        "family_proximity",
        "financial_baseline",
        "caregiving_arrangement",
        "social_routine",
        "texture_preference",
        "other"
      ]
    },
    "dimension": {
      "enum": [
        "economic",
        "relational",
        "legal_visa",
        "skill",
        "time",
        "health_baseline",
        "caregiving",
        "social_environment",
        "geography",
        "institutional",
        "agency"
      ]
    }
  }
}
