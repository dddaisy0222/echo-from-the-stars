{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echo.local/schemas/journey-state.v2.schema.json",
  "title": "Echo Journey State v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "journey_id",
    "seed_version",
    "base_profile_ref",
    "intent",
    "fork_moment",
    "unchosen_path",
    "real_path",
    "decision_mechanism",
    "invariants",
    "target_question",
    "confirmation",
    "rejected_tombstones",
    "revision_history"
  ],
  "properties": {
    "journey_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "seed_version": {
      "type": "integer",
      "minimum": 1
    },
    "base_profile_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_version"],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "profile_version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "intent": { "$ref": "#/$defs/singleField" },
    "fork_moment": { "$ref": "#/$defs/singleField" },
    "unchosen_path": { "$ref": "#/$defs/singleField" },
    "real_path": { "$ref": "#/$defs/singleField" },
    "decision_mechanism": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stated_reasons",
        "practical_constraints",
        "preferences_at_the_time",
        "fears",
        "hopes",
        "attachments",
        "unknowns"
      ],
      "properties": {
        "stated_reasons": { "$ref": "#/$defs/multiField" },
        "practical_constraints": { "$ref": "#/$defs/multiField" },
        "preferences_at_the_time": { "$ref": "#/$defs/multiField" },
        "fears": { "$ref": "#/$defs/multiField" },
        "hopes": { "$ref": "#/$defs/multiField" },
        "attachments": { "$ref": "#/$defs/multiField" },
        "unknowns": { "$ref": "#/$defs/multiField" }
      }
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reality_constraints", "valued_continuities"],
      "properties": {
        "reality_constraints": { "$ref": "#/$defs/multiField" },
        "valued_continuities": { "$ref": "#/$defs/multiField" }
      }
    },
    "target_question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "candidate_id",
        "verbatim",
        "simulation_focus",
        "evidence",
        "confirmed_at_turn_id"
      ],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "candidate_id": {
          "type": ["string", "null"],
          "maxLength": 100
        },
        "verbatim": {
          "type": ["string", "null"],
          "maxLength": 500
        },
        "simulation_focus": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "evidence": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "confirmed_at_turn_id": {
          "type": ["string", "null"],
          "maxLength": 100
        }
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "presented_seed_version",
        "confirmed_version",
        "confirmed_at_turn_id"
      ],
      "properties": {
        "status": {
          "enum": ["not_presented", "pending", "confirmed", "invalidated"]
        },
        "presented_seed_version": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "confirmed_version": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "confirmed_at_turn_id": {
          "type": ["string", "null"],
          "maxLength": 100
        }
      }
    },
    "rejected_tombstones": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "field_path",
          "normalized",
          "rejected_at_turn_id"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "field_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "normalized": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "rejected_at_turn_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      }
    },
    "revision_history": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "seed_version",
          "field_path",
          "operation",
          "turn_id",
          "created_at"
        ],
        "properties": {
          "seed_version": {
            "type": "integer",
            "minimum": 1
          },
          "field_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "operation": {
            "enum": ["propose", "replace", "confirm", "reject"]
          },
          "turn_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "$defs": {
    "status": {
      "enum": ["unknown", "candidate", "confirmed", "rejected"]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turn_id", "quote", "evidence_level"],
      "properties": {
        "turn_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "evidence_level": {
          "enum": ["explicit", "confirmed", "ambiguous"]
        }
      }
    },
    "singleField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "candidate_id",
        "verbatim",
        "normalized",
        "evidence",
        "confirmed_at_turn_id"
      ],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "candidate_id": {
          "type": ["string", "null"],
          "maxLength": 100
        },
        "verbatim": {
          "type": ["string", "null"],
          "maxLength": 500
        },
        "normalized": {
          "type": ["string", "null"],
          "maxLength": 500
        },
        "evidence": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "confirmed_at_turn_id": {
          "type": ["string", "null"],
          "maxLength": 100
        }
      }
    },
    "multiFieldItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "candidate_id",
        "verbatim",
        "normalized",
        "evidence",
        "confirmed_at_turn_id"
      ],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "candidate_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "verbatim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "normalized": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "confirmed_at_turn_id": {
          "type": ["string", "null"],
          "maxLength": 100
        }
      }
    },
    "multiField": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/multiFieldItem" }
    }
  }
}
