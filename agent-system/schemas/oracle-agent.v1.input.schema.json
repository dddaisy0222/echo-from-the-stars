{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echo.local/schemas/oracle-agent.v1.input.schema.json",
  "title": "Echo Oracle Agent Input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "world_id",
    "journey_id",
    "seed_version",
    "pack_id",
    "based_on_state_version",
    "mode",
    "reality_pack",
    "calibration_snapshot",
    "current_world_state",
    "trigger",
    "retrieval_bundle",
    "output_language",
    "generated_at"
  ],
  "properties": {
    "schema_version": { "const": "oracle-agent-input.v1" },
    "request_id": { "$ref": "#/$defs/id" },
    "transition_id": { "$ref": "#/$defs/id" },
    "world_id": { "$ref": "#/$defs/id" },
    "journey_id": { "$ref": "#/$defs/id" },
    "seed_version": { "type": "integer", "minimum": 1 },
    "pack_id": { "$ref": "#/$defs/id" },
    "based_on_state_version": { "type": "integer", "minimum": 0 },
    "mode": { "enum": ["calibrate", "initialize", "advance"] },
    "requested_node_id": { "$ref": "#/$defs/id" },
    "reality_pack": {
      "$ref": "https://echo.local/schemas/reality-pack.v1.schema.json"
    },
    "calibration_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "premises", "unresolved_topics"],
      "properties": {
        "status": { "enum": ["not_started", "in_progress", "ready"] },
        "premises": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "premise_id",
              "topic",
              "value",
              "premise_type",
              "source",
              "evidence_refs",
              "affects"
            ],
            "properties": {
              "premise_id": { "$ref": "#/$defs/id" },
              "topic": { "$ref": "#/$defs/calibrationTopic" },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 700
              },
              "premise_type": {
                "enum": [
                  "real_world_fact",
                  "counterfactual_premise",
                  "texture_preference"
                ]
              },
              "source": {
                "enum": [
                  "user_confirmed",
                  "user_selected_for_world",
                  "verified_reference"
                ]
              },
              "evidence_refs": {
                "type": "array",
                "maxItems": 12,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/id" }
              },
              "affects": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/dimension" }
              }
            }
          }
        },
        "unresolved_topics": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/calibrationTopic" }
        }
      }
    },
    "current_world_state": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "https://echo.local/schemas/world-state.v1.schema.json" }
      ]
    },
    "trigger": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "const": "world_initialized" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "const": "world_calibration_requested" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "event_id",
            "node_id",
            "choice_id",
            "world_state_version",
            "committed_at"
          ],
          "properties": {
            "type": { "const": "world_node_choice_committed" },
            "event_id": { "$ref": "#/$defs/id" },
            "node_id": { "$ref": "#/$defs/id" },
            "choice_id": { "$ref": "#/$defs/id" },
            "world_state_version": { "type": "integer", "minimum": 1 },
            "committed_at": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },
    "allowed_next_horizons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/horizon" }
    },
    "available_choice_ids": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "available_calibration_ids": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "available_candidate_ids": {
      "type": "array",
      "maxItems": 24,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "retrieval_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_id",
        "consumer",
        "task",
        "world_id",
        "records",
        "hypothesis_hints",
        "expires_at"
      ],
      "properties": {
        "bundle_id": { "$ref": "#/$defs/id" },
        "consumer": { "const": "oracle" },
        "task": {
          "enum": [
            "calibrate_world",
            "initialize_world",
            "advance_world_node"
          ]
        },
        "world_id": { "$ref": "#/$defs/id" },
        "records": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["record_id", "layer", "content"],
            "properties": {
              "record_id": { "$ref": "#/$defs/id" },
              "layer": { "enum": ["core", "observed", "archive"] },
              "content": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              }
            }
          }
        },
        "hypothesis_hints": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["hypothesis_id", "summary", "status"],
            "properties": {
              "hypothesis_id": { "$ref": "#/$defs/id" },
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "status": { "enum": ["emerging", "supported"] }
            }
          }
        },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    },
    "consented_uncertain_event_ids": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "output_language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40
    },
    "generated_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "mode": { "const": "calibrate" } },
        "required": ["mode"]
      },
      "then": {
        "required": ["available_calibration_ids", "available_candidate_ids"],
        "properties": {
          "based_on_state_version": { "const": 0 },
          "current_world_state": { "type": "null" },
          "trigger": {
            "properties": {
              "type": { "const": "world_calibration_requested" }
            }
          },
          "retrieval_bundle": {
            "properties": {
              "task": { "const": "calibrate_world" },
              "hypothesis_hints": { "maxItems": 0 }
            }
          }
        },
        "not": {
          "anyOf": [
            { "required": ["transition_id"] },
            { "required": ["requested_node_id"] },
            { "required": ["allowed_next_horizons"] },
            { "required": ["available_choice_ids"] },
            { "required": ["consented_uncertain_event_ids"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": { "mode": { "enum": ["initialize", "advance"] } },
        "required": ["mode"]
      },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["available_calibration_ids"] },
            { "required": ["available_candidate_ids"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": { "mode": { "const": "initialize" } },
        "required": ["mode"]
      },
      "then": {
        "required": [
          "transition_id",
          "requested_node_id",
          "allowed_next_horizons",
          "available_choice_ids",
          "consented_uncertain_event_ids"
        ],
        "properties": {
          "based_on_state_version": { "const": 0 },
          "current_world_state": { "type": "null" },
          "calibration_snapshot": {
            "properties": { "status": { "const": "ready" } }
          },
          "trigger": {
            "properties": { "type": { "const": "world_initialized" } }
          },
          "retrieval_bundle": {
            "properties": { "task": { "const": "initialize_world" } }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "mode": { "const": "advance" } },
        "required": ["mode"]
      },
      "then": {
        "required": [
          "transition_id",
          "requested_node_id",
          "allowed_next_horizons",
          "available_choice_ids",
          "consented_uncertain_event_ids"
        ],
        "properties": {
          "based_on_state_version": { "minimum": 1 },
          "calibration_snapshot": {
            "properties": { "status": { "const": "ready" } }
          },
          "current_world_state": {
            "$ref": "https://echo.local/schemas/world-state.v1.schema.json"
          },
          "trigger": {
            "properties": {
              "type": { "const": "world_node_choice_committed" }
            }
          },
          "retrieval_bundle": {
            "properties": { "task": { "const": "advance_world_node" } }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
    },
    "horizon": {
      "enum": [
        "week_1_2",
        "month_1",
        "month_3",
        "month_6",
        "year_1",
        "year_2_plus"
      ]
    },
    "calibrationTopic": {
      "enum": [
        "role_track",
        "housing",
        "commute_mode",
        "commute_duration",
        "work_schedule",
        "family_proximity",
        "financial_baseline",
        "caregiving_arrangement",
        "social_routine",
        "texture_preference",
        "other"
      ]
    },
    "dimension": {
      "enum": [
        "economic",
        "relational",
        "legal_visa",
        "skill",
        "time",
        "health_baseline",
        "caregiving",
        "social_environment",
        "geography",
        "institutional",
        "agency"
      ]
    }
  }
}
